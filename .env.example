# Copy to .env and fill in. Never commit .env.
# Overrides matching keys in config.yaml.

# Ollama (default local LLM backend)
OLLAMA_HOST=http://localhost:11434

# OpenAI-compatible backend (only needed if llm.backend is "openai")
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Flask session secret for the web UI
FLASK_SECRET=change-me-to-something-random
