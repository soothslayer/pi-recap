[Unit]
Description=pi-recap ambient conversation notes recorder
After=network.target sound.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-recap
ExecStart=/home/pi/pi-recap/venv/bin/python -m recap.main
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# The service user needs mic access: sudo usermod -aG audio pi

[Install]
WantedBy=multi-user.target
